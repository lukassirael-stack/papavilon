{
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(img|audio|video)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sprava",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/tym",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/zebricek",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(lib|supabase|test)/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(package.json|package-lock.json|vercel.json|README.md|.env.example|.gitignore|.vercelignore)",
      "destination": "/",
      "permanent": false
    }
  ]
}
