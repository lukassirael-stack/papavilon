{
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/sprava", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/tym", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
